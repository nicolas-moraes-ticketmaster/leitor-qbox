<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- GDS primárias -->
    <color name="brand">#024DDF</color>          <!-- neptune -->
    <color name="brand_dark">#023AA7</color>     <!-- neptune dark (hover/press) -->
    <color name="brand_darker">#012E86</color>   <!-- status bar -->
    <color name="tm_logo_blue">#1348E3</color>   <!-- fundo do logo "t" (ícone e splash) -->

    <!-- Superfícies (TM Dark) -->
    <color name="background">#121212</color>     <!-- cosmos -->
    <color name="surface">#1E1E1E</color>        <!-- cosmos raised -->
    <color name="card">#1E1E1E</color>
    <color name="divider">#2A2A2A</color>
    <color name="divider_strong">#646464</color> <!-- granite -->

    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#BFBFBF</color> <!-- moonrock -->
    <color name="text_muted">#949494</color>     <!-- slate -->

    <!-- Status do resultado: fundo / sub-superfície / texto -->
    <color name="idle">#1E1E1E</color>
    <color name="idle_sub">#121212</color>
    <!-- Validando: neutro, para o azul ficar exclusivo de "cancelado". -->
    <color name="processing">#2A2A2A</color>
    <color name="processing_sub">#1E1E1E</color>
    <color name="valid">#048851</color>          <!-- earth -->
    <color name="valid_sub">#03663D</color>
    <!-- Mestre em teal (roxo é "expirado"). -->
    <color name="master">#00838F</color>
    <color name="master_sub">#006169</color>
    <color name="used">#F26B1D</color>           <!-- já utilizado: laranja -->
    <color name="used_sub">#B84F14</color>
    <color name="sector">#FFD60A</color>         <!-- setor incorreto: amarelo (texto escuro) -->
    <color name="sector_sub">#C7A600</color>
    <color name="on_sector">#121212</color>
    <color name="expired">#A733FF</color>        <!-- expirado / QR inválido: roxo -->
    <color name="expired_sub">#7D26BF</color>
    <color name="voided">#024DDF</color>         <!-- neptune: ingresso cancelado -->
    <color name="voided_sub">#023AA7</color>
    <color name="denied">#EB0000</color>         <!-- mars -->
    <color name="denied_sub">#B00000</color>
    <!-- Erros de sistema (sem conexão, configuração): cinza, para não confundir com o amarelo de setor. -->
    <color name="warning">#5C6670</color>
    <color name="warning_sub">#454D55</color>
    <color name="on_warning">#FFFFFF</color>

    <color name="overlay">#BF000000</color>      <!-- rgba(0,0,0,.75) -->
</resources>
