<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configurações"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEvents"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Eventos cadastrados (Q-Box, Show ID, Token)" />

        <TextView
            style="@style/SettingsLabel"
            android:text="Nome deste leitor / portão (vai no campo gate e aparece no log do Q-Box)" />

        <EditText
            android:id="@+id/etGate"
            style="@style/SettingsField"
            android:hint="Catraca Norte 1"
            android:inputType="textCapWords" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swCheckOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Modo consulta (/check): só verifica, não marca o ingresso como usado"
            android:textColor="@color/text_primary" />

        <TextView
            style="@style/SettingsLabel"
            android:text="PIN do supervisor (opcional): protege eventos, setores e configurações" />

        <EditText
            android:id="@+id/etPin"
            style="@style/SettingsField"
            android:inputType="numberPassword"
            android:maxLength="8" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Salvar" />
    </LinearLayout>
</ScrollView>
