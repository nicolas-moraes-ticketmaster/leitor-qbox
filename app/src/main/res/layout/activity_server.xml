<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <View
            android:layout_width="24dp"
            android:layout_height="4dp"
            android:background="@color/brand" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Conexão com o servidor"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            style="@style/T.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="IP do Q-Box usado como padrão ao cadastrar eventos novos."
            android:textColor="@color/text_secondary" />

        <TextView
            style="@style/SettingsLabel"
            android:text="IP do Q-Box (porta 8080 é o padrão)" />

        <EditText
            android:id="@+id/etHost"
            style="@style/SettingsField"
            android:hint="192.168.22.231"
            android:inputType="textUri" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTest"
            style="@style/Btn.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Testar conexão" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyAll"
            style="@style/Btn.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Aplicar este IP a todos os eventos" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Btn.Primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:text="Salvar" />
    </LinearLayout>
</ScrollView>
