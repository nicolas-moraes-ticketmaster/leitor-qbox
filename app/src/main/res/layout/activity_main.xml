<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Cabeçalho azul -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:id="@+id/eventBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:minHeight="44dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/syncDot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/text_muted" />

                <TextView
                    android:id="@+id/tvSync"
                    style="@style/T.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvEvent"
                    style="@style/T.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@android:color/white" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron"
                    app:tint="@android:color/white" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSync"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sincronizar com o Q-Box"
            android:src="@drawable/ic_sync"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            android:src="@drawable/ic_menu"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Faixa: Q-Box fora do ar (verificação a cada 30 s) -->
    <LinearLayout
        android:id="@+id/offlineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/denied"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_warning"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/tvOffline"
            style="@style/T.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Q-Box fora do ar"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/btnRetry"
            style="@style/T.Body"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="Tentar agora"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- Faixa: nova versão do app no GitHub -->
    <LinearLayout
        android:id="@+id/updateBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_dark"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_download"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/tvUpdate"
            style="@style/T.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/btnUpdate"
            style="@style/T.Body"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="Atualizar"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Barra de setores (abre o BottomSheet) -->
        <LinearLayout
            android:id="@+id/sectorBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tile"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_venue_map"
                app:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/T.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Setores aceitos"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvSectorSummary"
                    style="@style/T.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSectorCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:fontFeatureSettings="tnum"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@android:color/white"
                android:textFontWeight="700"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:rotation="-90"
                android:src="@drawable/ic_chevron"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <!-- Painel de resultado -->
        <LinearLayout
            android:id="@+id/resultPanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivResultIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvEyebrow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:textFontWeight="600"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvResultTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:textFontWeight="600"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- espaço flexível: empurra o bloco do status para baixo -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Só no estado PRONTO / VALIDANDO -->
            <ImageView
                android:id="@+id/ivBigIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/pbBusy"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:indeterminateTint="@android:color/white"
                android:visibility="gone" />

            <View
                android:id="@+id/accent"
                android:layout_width="24dp"
                android:layout_height="4dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvResultTitle"
                style="@style/T.Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvResultHolder"
                style="@style/T.Holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Grade 2 colunas, preenchida pelo código -->
            <GridLayout
                android:id="@+id/gridRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:columnCount="2"
                android:useDefaultMargins="false" />

            <TextView
                android:id="@+id/tvResultNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4sp"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvResultCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textSize="12sp" />

            <!-- Barra de tempo até voltar para PRONTO -->
            <FrameLayout
                android:id="@+id/barTrack"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="6dp">

                <View
                    android:id="@+id/barFill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </LinearLayout>

        <!-- Métricas compactas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:divider="@drawable/divider_v"
            android:orientation="horizontal"
            android:showDividers="middle">

            <LinearLayout style="@style/MetricCell">
                <TextView android:id="@+id/tvOk" style="@style/MetricValue" android:textColor="@color/valid" />
                <TextView style="@style/MetricLabel" android:text="Liberados" />
            </LinearLayout>

            <LinearLayout style="@style/MetricCell">
                <TextView android:id="@+id/tvDenied" style="@style/MetricValue" android:textColor="@color/denied" />
                <TextView style="@style/MetricLabel" android:text="Negados" />
            </LinearLayout>

            <LinearLayout style="@style/MetricCell">
                <TextView android:id="@+id/tvRate" style="@style/MetricValue" />
                <TextView style="@style/MetricLabel" android:text="/min" />
            </LinearLayout>

            <LinearLayout style="@style/MetricCell">
                <TextView android:id="@+id/tvPct" style="@style/MetricValue" android:text="–" />
                <TextView style="@style/MetricLabel" android:text="Aprov." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKeyboard"
                style="@style/Btn.Secondary"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:contentDescription="Digitar código"
                android:padding="0dp"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScan"
                style="@style/Btn.Primary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Ler" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

    <!-- Menu lateral (hambúrguer) -->
    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/background"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/brand"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/T.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="LEITOR QBOX"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDrawerEvent"
                style="@style/T.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/tvDrawerSub"
                style="@style/T.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#D9FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/drawerItems"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/tvDrawerVersion"
            style="@style/T.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:textColor="@color/text_muted" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
